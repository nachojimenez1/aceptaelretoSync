{
  "manifest_version": 3,
  "name": "AceptaElReto to GitHub Sync",
  "version": "2.0",
  "description": "Sincroniza tus soluciones de Acepta el Reto con estadísticas y enunciados automáticamente.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.aceptaelreto.com/*",
    "https://aceptaelreto.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aceptaelreto.com/*",
        "https://aceptaelreto.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}